{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(mise exec -- just:*)",
      "Bash(mise exec -- bun run:*)",
      "Bash(mise exec -- bun x:*)",
      "Bash(mise exec -- bun install)",
      "Bash(mise exec -- bun pm:*)",
      "Bash(mise exec -- bun why:*)",
      "Bash(bun run:*)",
      "Bash(bun x:*)",
      "Bash(bun install)",
      "Bash(bun pm:*)",
      "Bash(bun why:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)", "Read(./**/*.key)"]
  }
}

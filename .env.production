# Example production environment for the ConsentGuard proxy.
# Copy to .env or export in your shell. Never commit real secrets.

PORT=3000
REDIS_URL=redis://localhost:6379

# Required. Bearer token for admin endpoints (/consent/:userId, /api/rules,
# /audit, /api/debug/reset). Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me

# Optional. Distinct secret for CMP webhook callbacks. Falls back to ADMIN_SECRET.
CG_WEBHOOK_SECRET=

# Required in production. Comma-separated list of origins allowed to POST to
# /ingest/* and /consent/self. An empty list means "allow all" — dev only.
CG_ALLOWED_ORIGINS=https://your-app.example.com

# Optional. Salt appended before hashing PII fields. Rotating this invalidates
# all previously-hashed values (which is usually what you want).
CG_HASH_SALT=change-me

# Optional. Hybrid in-memory cache in front of the primary storage.
CG_ENABLE_CACHE=true
CG_CACHE_TTL=60000

# Optional. "deny" (default) fails closed for users with no consent record.
CG_DEFAULT_CONSENT=deny

# GA4 vendor adapter. Required for the ga4 destination to actually forward.
# Get these from GA4 Admin → Data Streams → Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=G-XXXXXXX
GA4_API_SECRET=

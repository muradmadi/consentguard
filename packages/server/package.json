{
  "name": "@sluice/server",
  "private": true,
  "version": "0.0.0-dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "@sluice/shared": "*",
    "hono": "^4.13.3",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^6.0.3"
  }
}
